<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 离线横幅需要读网络状态（NetworkMonitor），非危险权限，安装即授予 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 计时结束的振动提示，普通权限，安装即授予 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 今日步数：Health Connect 读步数；传感器降级路径需要 ACTIVITY_RECOGNITION（运行时权限） -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- B1 自动核销：读运动 session（今日运动分钟数）与睡眠 session（昨晚睡眠时长） -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:name=".BetterLifeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetterLife"
        tools:targetApi="33">

        <!--
          Activity 用 Splash 主题：installSplashScreen() 会把 postSplashScreenTheme
          （= Theme.BetterLife）应用上去。两个主题的 windowBackground 同源，
          所以从系统启动画面到 Compose 首帧之间不会出现颜色跳变。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BetterLife.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Health Connect 官方要求的固定声明：
              用户在 Health Connect 里管理权限时，系统据此打开本 App 的隐私说明入口；
              缺了这两个 intent-filter，授权页里本 App 会被标为「未提供隐私说明」。
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- 分享卡片图片(EntryDetailScreen 生成的 PNG)通过 FileProvider 授予临时读权限 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- B5「今日任务」桌面小部件 -->
        <receiver
            android:name=".widget.TodayTasksWidgetReceiver"
            android:exported="false"
            android:label="@string/today_tasks_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_tasks_widget" />
        </receiver>
    </application>
</manifest>
