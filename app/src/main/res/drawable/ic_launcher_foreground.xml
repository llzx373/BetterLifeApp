<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：百分比 % = 「健康与财富的配比」。
  斜杠是旧天平梁的化身，骑在拼色底的分界线上；两个点分别是心（健康域）与
  硬币（财富域）。视口 108x108，元素已收在 66dp 安全圆内（最远处约 31.4）。
  注意：Theme.BetterLife.Splash 的 windowSplashScreenAnimatedIcon 直接引用本 drawable，
  改形状时启动画面会跟着变；monochrome 动态取色图标也引用本 drawable。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 斜杠（梁）：(40,70)→(68,38)，与拼色底分界线共线 -->
    <path
        android:pathData="M40,70 L68,38"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
    <!-- 心点（左上）：由原天平心形（宽 28.98）按 0.5414 缩放平移至中心 (40.5,42.5) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32.65,40.17 A4.6,4.6 0 1 1 41.85,40.17 A4.6,4.6 0 1 1 32.65,40.17 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M39.15,40.17 A4.6,4.6 0 1 1 48.35,40.17 A4.6,4.6 0 1 1 39.15,40.17 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40.5,36.92 L47,43.42 L41.35,49.07 L39.65,49.07 L34,43.42 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M39.31,48.23 A1.19,1.19 0 1 1 41.69,48.23 A1.19,1.19 0 1 1 39.31,48.23 Z" />
    <!-- 硬币圆环（右下）：中心 (67.5,65.5)，r=8.5 -->
    <path
        android:pathData="M59,65.5 A8.5,8.5 0 1 1 76,65.5 A8.5,8.5 0 1 1 59,65.5 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8" />
    <!-- ¥ 符号（相对原稿按 8.5/13 缩放） -->
    <path
        android:pathData="M64.95,61.68 L67.5,65.08 L70.05,61.68 M67.5,65.08 L67.5,70.17 M65.21,66.78 L69.79,66.78 M65.21,68.9 L69.79,68.9"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.83" />
</vector>
